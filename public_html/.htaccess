# Template demo pages that were never part of the site
RewriteRule ^blog(-details)?\.html$ - [R=404,L]

# 0b. Package search / destination results: /tours and /tours/{destination}
RewriteRule ^tours/$ /tours [R=301,L]
RewriteRule ^tours/([a-z0-9-]+)/$ /tours/$1 [R=301,L]
RewriteRule ^tours/([a-z0-9-]+)$ tours.php?dest=$1 [QSA,L]

# 0c. Travel guides: /travel-guide/{slug} serves travel-guide/{slug}.php
RewriteCond %{THE_REQUEST} \s/+travel-guide/[^?\s]+\.php[\s?]
RewriteRule ^travel-guide/([a-z0-9-]+)\.php$ /travel-guide/$1 [R=301,L]
RewriteRule ^travel-guide/([a-z0-9-]+)/$ /travel-guide/$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/travel-guide/$1.php -f
RewriteRule ^travel-guide/([a-z0-9-]+)$ travel-guide/$1.php [L]
RewriteRule ^travel-guide/?$ - [R=404,L]

# 0d. Blog articles: /blog/{slug} is served by blog-article.php (unknown slugs return the 404 page)
RewriteRule ^blog/([a-z0-9-]+)/$ /blog/$1 [R=301,L]
RewriteRule ^blog/([a-z0-9-]+)$ blog-article.php?slug=$1 [QSA,L]

# 1. /index.php and /index -> /
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?]
RewriteRule ^index(\.php)?$ / [R=301,L]

# 2. /page.php -> /page (only when the browser asked for .php; internal rewrites are skipped,
#    so there is no loop). Query strings are kept. Form endpoints and the 404 page are excluded.
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.php[\s?]
RewriteCond $1 !^(mail|mail1|404)$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^([^/]+)\.php$ /$1 [R=301,L]

# 3. /page/ -> /page
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/.]+)/$ /$1 [R=301,L]

# 4. /page -> page.php (internal, no redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond $1 !^(mail|mail1|404|index)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/.]+)$ $1.php [L]

# Anything else that does not exist gets the real 404 page above (no homepage fallback).
</IfModule>
