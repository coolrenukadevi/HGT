RewriteRule ^kerala-munnar-thekkady-alleppey-kovalam-trivandrum-6n-7d(\.php)?/?$ /kerala-munnar-thekkady-alleppey-kovalam-trivandrum [R=301,L]
RewriteRule ^kerala-munnar-thekkady-alleppey-kovalam-kanyakumari-6n-7d(\.php)?/?$ /kerala-munnar-thekkady-alleppey-kovalam-kanyakumari [R=301,L]
