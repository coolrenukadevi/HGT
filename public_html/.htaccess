RewriteRule ^grand-himachal-with-mata-vaishno-devi--tour-13-days(\.php)?/?$ /himachal-shimla-manali-dharamshala-vaishno-devi [R=301,L]
RewriteRule ^haridwar--with-mussoorie-and-corbett-06-days(\.php)?/?$ /uttarakhand-haridwar-mussoorie-corbett [R=301,L]
RewriteRule ^manali-volvo-vrip-weekend(\.php)?/?$ /himachal-manali-kullu-volvo [R=301,L]
