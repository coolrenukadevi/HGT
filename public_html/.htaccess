# Holiday Guru Travel — public URL routing
# Canonical page URLs are extensionless: /about serves about.php, /about.php 301s to /about.
# Only root-level pages that exist as <name>.php are affected; assets, sub-folders,
# PHPMailer, admin and the form endpoints (mail.php, mail1.php) are untouched.

Options -MultiViews -Indexes
AcceptPathInfo Off
DirectoryIndex index.php
ErrorDocument 404 /404.php

# Security headers (Phase 0). Deliberately NOT set here yet:
# - Strict-Transport-Security: needs HTTPS verified on the live host first.
# - A full Content-Security-Policy: the site relies on inline scripts/styles; only
#   frame-ancestors is set, which does not restrict scripts, styles or images.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Compression and browser caching (Phase 1, owner approval 2026-10-01). Every block is inside <IfModule>,
# so a host without the module simply skips it.
# - Text responses (pages, CSS, JS, SVG, JSON, XML) are gzip-compressed.
# - CSS and JS links carry ?v=<file time> (hg_asset in include/ui/core.php), so they are cached for a year and an
#   upload still reaches visitors at once. Font files never change name: one year.
# - Photos: 30 days. A photo replaced under the SAME file name can show the old copy for up to 30 days.
# - Pages (HTML/PHP) are not cached, so content edits appear immediately.
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json image/svg+xml image/x-icon image/vnd.microsoft.icon
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0. Consolidated pages (single 301 hop, also from the old .php URL)
RewriteRule ^whyus(\.php)?/?$ /why-us [R=301,L]
RewriteRule ^kashmir-tour(\.php)?/?$ /tours/kashmir [R=301,L]
# Approved URL migrations (owner, 2026-10-04): en dash "–" in the URL -> ASCII hyphen. Single hop, also from .php
# and trailing-slash forms. The pattern holds the literal en dash (UTF-8); Apache/LiteSpeed match the decoded path.
# Mapping: docs/url-migrations.csv
RewriteRule ^do-dham-kedar–badri-from-haridwar-4n-5d(\.php)?/?$ /do-dham-kedar-badri-from-haridwar [R=301,L]
RewriteRule ^do-dham-kedar–badri-from-haridwar-5n-6d(\.php)?/?$ /do-dham-kedar-badri-from-haridwar-with-kedarnath-night [R=301,L]
# Premium URL standard migrations (owner, 2026-10-05): typos / double hyphens. One 301 hop, also from .php and
# trailing-slash forms. Mapping: docs/url-migrations.csv
RewriteRule ^amrirsar-with-dalhousie-and-dharamshala-06-days(\.php)?/?$ /himachal-amritsar-dharamshala-dalhousie [R=301,L]
