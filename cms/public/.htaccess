# Apache/LiteSpeed (staging/production): route everything except real files to the front controller.
# The CMS document root must be cms/public only — never the repository root.
Options -Indexes
RewriteEngine On
# Real files in this folder (cms-assets/*) are served as they are; everything else goes to the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
