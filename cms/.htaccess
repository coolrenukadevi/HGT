# Tour Package CMS. The web root is cms/public/. This file makes the CMS work whichever folder the subdomain
# points to: cms/public (recommended) or cms itself. Requests reaching this folder are passed into public/,
# so the code, config and database (src, storage, bin, schema, config.php) are never served. The private
# folders also block themselves with their own .htaccess. Nothing here blocks cms/public/, so it works on
# Apache and LiteSpeed (Hostinger), where a child folder cannot re-allow what a parent folder denies.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "(^config.*\.php|\.(md|sql|sqlite|sqlite-wal|sqlite-shm|log)$|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
